{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "field_spec",
  "type": "object",
  "required": ["table_name", "version", "fields"],
  "additionalProperties": false,
  "properties": {
    "table_name": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "based_on_upstream_schema_fetched_at": { "type": ["string", "null"], "format": "date-time" },
    "based_on_upstream_dataset_urn": { "type": ["string", "null"] },
    "change_note": { "type": ["string", "null"] },

    "table_level_checks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_row_count": { "type": ["integer", "null"], "minimum": 0 },
        "max_row_count": { "type": ["integer", "null"], "minimum": 0 }
      }
    },

    "fields": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/field" }
    }
  },

  "definitions": {
    "field": {
      "type": "object",
      "required": ["name", "dtype", "nullable", "unique", "invalid_value_tokens", "confidence", "source"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "dtype": { "type": "string", "enum": ["string", "int", "float", "datetime", "boolean"] },
        "semantic_tag": { "type": ["string", "null"] },
        "nullable": { "type": "boolean" },
        "unique": { "type": "boolean" },

        "allow_empty_string": { "type": ["boolean", "null"] },
        "enum_values": {
          "type": ["array", "null"],
          "items": { "type": "string" }
        },
        "pattern": { "type": ["string", "null"] },

        "min_value": { "type": ["number", "null"] },
        "max_value": { "type": ["number", "null"] },

        "datetime_after": { "type": ["string", "null"] },
        "datetime_before": { "type": ["string", "null"] },
        "expected_datetime_format": { "type": ["string", "null"] },

        "invalid_value_tokens": {
          "type": "array",
          "items": { "type": "string" }
        },

        "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
        "source": { "type": "string", "enum": ["upstream_schema", "discussed_with_user"] }
      },

      "allOf": [
        {
          "if": { "properties": { "dtype": { "const": "string" } } },
          "then": {}
        },
        {
          "if": { "not": { "properties": { "dtype": { "const": "string" } } } },
          "then": {
            "properties": {
              "allow_empty_string": { "const": null },
              "pattern": { "const": null }
            }
          }
        },
        {
          "if": { "not": { "properties": { "dtype": { "const": "datetime" } } } },
          "then": {
            "properties": {
              "datetime_after": { "const": null },
              "datetime_before": { "const": null },
              "expected_datetime_format": { "const": null }
            }
          }
        },
        {
          "if": {
            "anyOf": [
              { "properties": { "dtype": { "const": "int" } } },
              { "properties": { "dtype": { "const": "float" } } }
            ]
          },
          "then": {}
        }
      ]
    }
  }
}
