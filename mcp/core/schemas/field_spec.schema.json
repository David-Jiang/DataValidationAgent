{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "field_spec",
  "type": "object",
  "required": ["table_name", "fields"],
  "additionalProperties": false,
  "properties": {
    "table_name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/definitions/string_field" },
          { "$ref": "#/definitions/int_field" },
          { "$ref": "#/definitions/float_field" },
          { "$ref": "#/definitions/datetime_field" },
          { "$ref": "#/definitions/boolean_field" }
        ]
      }
    }
  },
  "definitions": {
    "string_field": {
      "type": "object",
      "required": [
        "name",
        "dtype",
        "nullable",
        "unique",
        "invalid_value_tokens",
        "allow_empty_string",
        "enum_values",
        "pattern",
        "confidence",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "dtype": { "const": "string" },
        "nullable": { "type": "boolean" },
        "unique": { "type": "boolean" },
        "invalid_value_tokens": {
          "type": "array",
          "default": ["NULL", "null", "NA", "None", "none"],
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "allow_empty_string": { "type": "boolean" },
        "enum_values": {
          "type": ["array", "null"],
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "pattern": { "type": ["string", "null"] },
        "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
        "source": {
          "type": "string",
          "enum": ["upstream_schema", "discussed_with_user"]
        }
      }
    },
    "int_field": {
      "type": "object",
      "required": [
        "name",
        "dtype",
        "nullable",
        "invalid_value_tokens",
        "min_value",
        "max_value",
        "confidence",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "dtype": { "const": "int" },
        "nullable": { "type": "boolean" },
        "invalid_value_tokens": {
          "type": "array",
          "default": ["NULL", "null", "NA", "None", "none"],
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "min_value": { "type": ["integer", "null"] },
        "max_value": { "type": ["integer", "null"] },
        "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
        "source": {
          "type": "string",
          "enum": ["upstream_schema", "discussed_with_user"]
        }
      }
    },
    "float_field": {
      "type": "object",
      "required": [
        "name",
        "dtype",
        "nullable",
        "invalid_value_tokens",
        "min_value",
        "max_value",
        "confidence",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "dtype": { "const": "float" },
        "nullable": { "type": "boolean" },
        "invalid_value_tokens": {
          "type": "array",
          "default": ["NULL", "null", "NA", "None", "none"],
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "min_value": { "type": ["number", "null"] },
        "max_value": { "type": ["number", "null"] },
        "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
        "source": {
          "type": "string",
          "enum": ["upstream_schema", "discussed_with_user"]
        }
      }
    },
    "datetime_field": {
      "type": "object",
      "required": [
        "name",
        "dtype",
        "nullable",
        "invalid_value_tokens",
        "datetime_after",
        "datetime_before",
        "expected_datetime_format",
        "confidence",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "dtype": { "const": "datetime" },
        "nullable": { "type": "boolean" },
        "invalid_value_tokens": {
          "type": "array",
          "default": ["NULL", "null", "NA", "None", "none"],
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "datetime_after": { "type": ["string", "null"] },
        "datetime_before": { "type": ["string", "null"] },
        "expected_datetime_format": { "type": ["string", "null"] },
        "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
        "source": {
          "type": "string",
          "enum": ["upstream_schema", "discussed_with_user"]
        }
      }
    },
    "boolean_field": {
      "type": "object",
      "required": [
        "name",
        "dtype",
        "nullable",
        "invalid_value_tokens",
        "confidence",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "dtype": { "const": "boolean" },
        "nullable": { "type": "boolean" },
        "invalid_value_tokens": {
          "type": "array",
          "default": ["NULL", "null", "NA", "None", "none"],
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
        "source": {
          "type": "string",
          "enum": ["upstream_schema", "discussed_with_user"]
        }
      }
    }
  }
}
